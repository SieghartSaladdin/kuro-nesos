// Icon resource 1 is used for the executable and the tray icon.
1 ICON "assets/kuro-nesos.ico"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Kuro Nesos - a living notch for Windows"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "kuro-nesos"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "kuro-nesos.exe"
            VALUE "ProductName", "Kuro Nesos"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
